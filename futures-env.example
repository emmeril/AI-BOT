# Binance USD-M Futures grid bot
# Copy to .env before running npm run start:futures.

EXCHANGE_API_KEY=your_binance_futures_demo_key
EXCHANGE_SECRET=your_binance_futures_demo_secret

# testnet uses Binance Futures Demo Trading endpoints. Start here.
EXCHANGE_MODE=testnet
SYMBOLS=BTC/USDT:USDT

# Binance account and symbol settings applied during startup.
LEVERAGE=5
MARGIN_MODE=ISOLATED

INTERVAL_MINUTES=1
# WebSocket delivers fills immediately; the regular REST cycle remains the recovery path.
FUTURES_USER_STREAM_ENABLED=true
FUTURES_USER_STREAM_RECONCILE_DEBOUNCE_MS=750
FUTURES_USER_STREAM_KEEPALIVE_MINUTES=45
FUTURES_USER_STREAM_RECONNECT_MAX_SECONDS=30
# Funding income changes infrequently; sync it separately from the grid cycle.
FUNDING_SYNC_INTERVAL_MINUTES=60
GRID_MODE=ARITHMETIC
GRID_COUNT=10
GRID_LOWER_PRICE=0
GRID_UPPER_PRICE=0
GRID_RANGE_PCT=5
GRID_ORDER_SIZE_USDT=20
GRID_TOTAL_INVESTMENT_USDT=0
# Position exposure plus pending BUY notional across configured symbols.
FUTURES_MAX_SYMBOL_EXPOSURE_USDT=400
FUTURES_MAX_TOTAL_EXPOSURE_USDT=400

GRID_MAX_ACTIVE_BUY_ORDERS=5
# Soft warning threshold only. Tracked SELL exits remain eligible above it.
GRID_MAX_ACTIVE_SELL_ORDERS=5
GRID_RECREATE_ON_START=false
GRID_CANCEL_OUT_OF_RANGE=true
GRID_CANCEL_OUT_OF_RANGE_THRESHOLD_MINUTES=3
GRID_REFILL_ON_FILLED=true
GRID_MAX_REFILLS=2
GRID_AGGREGATED_EXIT_LADDER_ENABLED=false
GRID_AGGREGATED_EXIT_LADDER_MAX_ORDERS=7
GRID_AGGREGATED_EXIT_LADDER_SYMBOLS=
GRID_POST_ONLY=true
# Maker fee used by the fee-aware grid spacing/profit guard.
BINANCE_FUTURES_MAKER_FEE_RATE=0.0002
GRID_MIN_NET_PROFIT_PCT=0.05
# Prevent grid SELL orders below Binance's current average LONG entry.
FUTURES_SELL_ENTRY_FLOOR_ENABLED=true

FIBONACCI_RANGE_ADVISOR_ENABLED=false
FIBONACCI_RANGE_ADVISOR_TIMEFRAMES=all
FIBONACCI_RANGE_ADVISOR_RATIOS=0,0.236,0.382,0.5,0.618,0.786,1,1.272,1.618,2,2.618
FIBONACCI_RANGE_ADVISOR_CANDLE_CLOSE_BUFFER_SECONDS=5
FIBONACCI_RANGE_ADVISOR_CLUSTER_TOLERANCE_PCT=0.15
FIBONACCI_RANGE_ADVISOR_MIN_CLUSTER_SCORE=1
FIBONACCI_RANGE_ADVISOR_MIN_RANGE_WIDTH_PCT=6
FIBONACCI_RANGE_ADVISOR_MAX_DISTANCE_PCT=25
FIBONACCI_RANGE_ADVISOR_REBUILD_THRESHOLD_PCT=0.5
FIBONACCI_RANGE_ADVISOR_REBUILD_COOLDOWN_MINUTES=15
FIBONACCI_RANGE_ADVISOR_APPLY_ON=AUTO_RANGE_ONLY
FIBONACCI_RANGE_ADVISOR_ALLOW_TRAILING=false
FIBONACCI_RANGE_ADVISOR_STATE_FILE=fibonacci-range-advisor-futures.json

# Futures-only deterministic direction analyzer. It reads closed candles,
# HH/HL or LH/LL structure, EMA alignment/slope, ATR, and the 0.5-0.618 golden
# zone. When confidence passes the threshold, it changes only the distribution
# of existing Fibonacci confluence levels below/above price. Start a live rollout
# with APPLY_MODE=REPORT_ONLY and observe its logs before using LEVEL_BIAS.
FIBONACCI_DIRECTION_ANALYZER_ENABLED=false
FIBONACCI_DIRECTION_TIMEFRAMES=15m,1h,4h
FIBONACCI_DIRECTION_CANDLE_LIMIT=100
FIBONACCI_DIRECTION_PIVOT_LOOKBACK=2
FIBONACCI_DIRECTION_MIN_TIMEFRAMES=2
FIBONACCI_DIRECTION_CONFIRMATIONS=2
FIBONACCI_DIRECTION_MIN_CONFIDENCE=0.65
FIBONACCI_DIRECTION_LEVEL_BIAS_PCT=10
FIBONACCI_DIRECTION_APPLY_MODE=REPORT_ONLY

# SHADOW only logs recommendations. LIVE applies sizing and spacing to
# new/refill BUY orders without changing the configured cap or tracked SELL exits.
ADAPTIVE_GRID_SUPERVISOR_ENABLED=false
ADAPTIVE_GRID_SUPERVISOR_MODE=SHADOW
ADAPTIVE_GRID_SUPERVISOR_PROFILE_CONFIRMATIONS=3
ADAPTIVE_GRID_SUPERVISOR_COOLDOWN_MINUTES=120
ADAPTIVE_GRID_SUPERVISOR_RISK_EXPOSURE_PCT=90
ADAPTIVE_GRID_SUPERVISOR_LOG_FILE=adaptive-grid-shadow.jsonl

# Separate safety state machine. Start in SHADOW so decisions are logged but
# do not change BUY orders. LIVE keeps SELL exits active and cancels pending
# BUY orders when the state reaches RISK_OFF.
ADAPTIVE_RISK_STATE_MACHINE_ENABLED=false
ADAPTIVE_RISK_STATE_MACHINE_MODE=SHADOW
ADAPTIVE_RISK_STATE_MACHINE_CAUTION_EXPOSURE_PCT=75
ADAPTIVE_RISK_STATE_MACHINE_RISK_EXPOSURE_PCT=90
ADAPTIVE_RISK_STATE_MACHINE_LOSS_WARNING_PCT=5
ADAPTIVE_RISK_STATE_MACHINE_LOSS_RISK_OFF_PCT=10
ADAPTIVE_RISK_STATE_MACHINE_LIQUIDATION_WARNING_PCT=12
ADAPTIVE_RISK_STATE_MACHINE_LIQUIDATION_CRITICAL_PCT=8
ADAPTIVE_RISK_STATE_MACHINE_CAUTION_CONFIRMATIONS=2
ADAPTIVE_RISK_STATE_MACHINE_RECOVERY_CONFIRMATIONS=3
ADAPTIVE_RISK_STATE_MACHINE_MARGIN_CALL_HOLD_MINUTES=60

# Futures ROI thresholds (despite the legacy PRICE suffix). The complete active
# LONG is closed at ROI <= -100% or ROI >= 100%. Set either value to 0 to disable.
GRID_STOP_LOSS_PRICE=-100
GRID_TAKE_PROFIT_PRICE=100

GRID_STATE_FILE=grid-state-futures.json
BOT_LOCK_FILE=grid-state-futures.json.lock
STOP_TRADING=false
KILL_SWITCH_ENABLED=true
KILL_SWITCH_FILE=futures-bot-paused.flag

# Records the final Adaptive Supervisor decision and 4h/24h price outcomes.
# This journal observes decisions only and never changes order execution.
ADAPTIVE_SUPERVISOR_OUTCOME_JOURNAL_ENABLED=false
ADAPTIVE_SUPERVISOR_OUTCOME_JOURNAL_MODE=SHADOW
ADAPTIVE_SUPERVISOR_OUTCOME_JOURNAL_LOG_FILE=adaptive-supervisor-outcomes.jsonl
ADAPTIVE_SUPERVISOR_OUTCOME_JOURNAL_STATE_FILE=adaptive-supervisor-outcomes-state.json

TELEGRAM_ENABLED=false

FUTURES_DASHBOARD_ENABLED=true
FUTURES_DASHBOARD_HOST=127.0.0.1
FUTURES_DASHBOARD_PORT=3988
FUTURES_DASHBOARD_REFRESH_SECONDS=5
FUTURES_DASHBOARD_CHART_TIMEFRAME=1m
FUTURES_DASHBOARD_CHART_LIMIT=120
FUTURES_DASHBOARD_AUTH_ENABLED=false
# Set credentials and enable authentication before exposing the dashboard beyond localhost.
FUTURES_DASHBOARD_USERNAME=
FUTURES_DASHBOARD_PASSWORD=
